    "block_path_value_head_definition": "critic_block_path_value_head outputs 24 x 3 path values on top of the existing critic_backbone; each block emits [V_local_b(s), V_bs1_b(s), V_bs2_b(s)] while the global critic head stays unchanged.",
    "path_td_supervision_mode_definitions": {
      "blockwise_action_conditioned_td_advantage_surrogate_mean": "p_local = 1 - sigmoid(theta_b); p_bs1, p_bs2 = sigmoid(theta_b) * softmax(route_logits_b); cost_act_b_now = p_local * cost_local_b(now) + p_bs1 * cost_bs1_b(now) + p_bs2 * cost_bs2_b(now); cost_act_b_next = p_local * cost_local_b(next) + p_bs1 * cost_bs1_b(next) + p_bs2 * cost_bs2_b(next); delta_cost_b = cost_act_b_next - cost_act_b_now; r_b = -delta_cost_b = cost_act_b_now - cost_act_b_next; A_b = r_b + gamma * (1 - done) * V_b(s_next) - V_b(s).",
      "blockwise_action_conditioned_path_value_td_advantage_surrogate_mean": "p_local = 1 - sigmoid(theta_b); p_bs1, p_bs2 = sigmoid(theta_b) * softmax(route_logits_b); cost_act_b_now = p_local * cost_local_b(now) + p_bs1 * cost_bs1_b(now) + p_bs2 * cost_bs2_b(now); cost_act_b_next = p_local * cost_local_b(next) + p_bs1 * cost_bs1_b(next) + p_bs2 * cost_bs2_b(next); delta_cost_b = cost_act_b_next - cost_act_b_now; r_b = -delta_cost_b = cost_act_b_now - cost_act_b_next; V_act_b(s) = p_local * V_local_b(s) + p_bs1 * V_bs1_b(s) + p_bs2 * V_bs2_b(s); V_act_b(s_next) = p_local * V_local_b(s_next) + p_bs1 * V_bs1_b(s_next) + p_bs2 * V_bs2_b(s_next); A_b = r_b + gamma * (1 - done) * V_act_b(s_next) - V_act_b(s).",
      "blockwise_path_specific_td_supervised_advantage_surrogate_mean": "p_local = 1 - sigmoid(theta_b); p_bs1, p_bs2 = sigmoid(theta_b) * softmax(route_logits_b); cost_act_b_now = p_local * cost_local_b(now) + p_bs1 * cost_bs1_b(now) + p_bs2 * cost_bs2_b(now); cost_act_b_next = p_local * cost_local_b(next) + p_bs1 * cost_bs1_b(next) + p_bs2 * cost_bs2_b(next); delta_cost_b = cost_act_b_next - cost_act_b_now; r_b = -delta_cost_b = cost_act_b_now - cost_act_b_next; r_local_b = cost_local_b(now) - cost_local_b(next); r_bs1_b = cost_bs1_b(now) - cost_bs1_b(next); r_bs2_b = cost_bs2_b(now) - cost_bs2_b(next); T_local_b = r_local_b + gamma * (1 - done) * V_local_b(s_next); T_bs1_b = r_bs1_b + gamma * (1 - done) * V_bs1_b(s_next); T_bs2_b = r_bs2_b + gamma * (1 - done) * V_bs2_b(s_next); critic_block_path_value_head is directly supervised against [T_local_b, T_bs1_b, T_bs2_b]; actor still uses V_act_b(s) = p_local * V_local_b(s) + p_bs1 * V_bs1_b(s) + p_bs2 * V_bs2_b(s), A_b = r_b + gamma * (1 - done) * V_act_b(s_next) - V_act_b(s)."
